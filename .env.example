# Environment Variables - Copy this file to .env and fill in your values
# NEVER commit .env file to the repository!
# On the server keep it readable by root only: chmod 600 .env

# Server Configuration
PORT=3000
NODE_ENV=production

# Public base URL used in canonical links and sitemap.
# Replace with your domain when you have one (e.g. https://masterdom.ru)
BASE_URL=http://185.22.172.45:3000

# Admin Security
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=your-secure-random-secret-here

# ============ AI article studio ============
# Secret path of the article generation tool (set your own random value!)
STUDIO_PATH=/studio-x9k2m

# Which provider to prefer when several keys are set: openrouter | anthropic | zai
AI_PROVIDER=openrouter

# OpenRouter (preferred) - https://openrouter.ai  (OpenAI-compatible)
OPENROUTER_API_KEY=
# Default model for article generation (capable). Chat uses a cheaper one below.
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Claude API (Anthropic, direct) - https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6

# Z.ai API (GLM) - https://z.ai
ZAI_API_KEY=
ZAI_MODEL=glm-4.6

# ============ Calculator AI chat ============
# The /calculator chat assistant reuses the keys above. To keep costs low it
# uses a cheap model and a small reply length, and is protected by hard caps.
#
# Cheap model for the chat when using OpenRouter (the preferred provider)
CHAT_OPENROUTER_MODEL=anthropic/claude-3.5-haiku
# Cheap model for the chat (Anthropic direct). Leave default unless you know better.
CHAT_ANTHROPIC_MODEL=claude-haiku-4-5
# Cheap model for the chat when using Z.ai (defaults to ZAI_MODEL if unset)
CHAT_ZAI_MODEL=glm-4.6
# Max tokens per reply (output length cap)
CHAT_MAX_TOKENS=400
# Max characters accepted per user message
CHAT_MAX_INPUT=600
# Hard limit: AI replies per visitor IP per day
CHAT_DAILY_PER_IP=25
# Hard limit: AI replies for the whole site per day (budget ceiling)
CHAT_DAILY_GLOBAL=400
